# Database
DATABASE_URL=postgres://magiklead:magiklead@localhost:5555/magiklead?sslmode=disable

# Redis
REDIS_URL=localhost:6380

# Object storage (S3-compatible; MinIO for dev, Hetzner/AWS S3 in prod)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=magiklead
S3_SECRET_KEY=magiklead-secret
S3_BUCKET=magiklead-raw-ingests
S3_REGION=us-east-1
S3_USE_SSL=false

# SEC EDGAR ingestion (cmd/ingest sec-edgar). SEC requires a User-Agent
# identifying the requester; format: "Company contact@domain.com".
# EDGAR_MAX_RECORDS caps parsed officers per batch — useful for smoke
# testing (set to 0 for no cap).
SEC_USER_AGENT=MagikLead ops@magiklead.io
EDGAR_MAX_RECORDS=0

# Wikidata SPARQL ingestion (cmd/ingest wikidata). WMF's user-agent
# policy requires contact info:
# https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIDATA_USER_AGENT=MagikLead/1.0 ops@magiklead.io
# WIKIDATA_QUERY=<override SPARQL query>
# WIKIDATA_ENDPOINT=<override endpoint>

# CrunchBase CSV ingestion (cmd/ingest crunchbase). Point to a directory
# containing people.csv, organizations.csv, and jobs.csv (CrunchBase's
# bulk-export schema).
CRUNCHBASE_CSV_DIR=/path/to/crunchbase/dump

# Team-page scraping (cmd/ingest teampages). Either a comma-separated
# domain list or a path to a file with one domain per line. Claude
# extracts names + titles from the HTML — ANTHROPIC_API_KEY required.
TEAMPAGES_DOMAINS=anthropic.com,datadog.com
# TEAMPAGES_DOMAINS_FILE=/path/to/domains.txt
# TEAMPAGES_USER_AGENT=MagikLead/1.0 (+https://magiklead.io/bot)

# Email verification (cmd/verify-emails). HELO host + MAIL FROM envelope
# used on SMTP handshakes. Production needs a reputation-owned IP that
# reverse-resolves to the HELO host; defaults are fine for dev.
SMTP_HELO=magiklead.io
SMTP_MAIL_FROM=verify@magiklead.io

# Clerk
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# RapidAPI
RAPIDAPI_KEY=...

# Gmail OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3040/api/gmail/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_SCALE_MONTHLY=price_...
STRIPE_PRICE_SCALE_ANNUAL=price_...

# App
NEXT_PUBLIC_API_URL=http://localhost:8040
FRONTEND_URL=http://localhost:3040
PORT=8040
