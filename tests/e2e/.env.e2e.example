# MagikLead E2E config — copy to ~/.config/devpods/magiklead/.env.e2e
# (preferred) or tests/e2e/.env.e2e and fill in. .env.e2e is gitignored.
#
# The minimum AFK config (works against any healthy devpod):
#
#   CLERK_SECRET_KEY     — same `sk_test_…` value already in .env.backend
#   E2E_API_URL          — http://api-<devpod>.magiklead.localhost
#   E2E_FRONTEND_URL     — http://<devpod>.magiklead.localhost
#
# DB access is via `devpods exec postgres psql` (the devpod doesn't
# expose Postgres to the host). The helpers shell out to the
# `devpods` CLI — make sure it's on PATH for the runner.
#
# Real-creds upgrades (each gate flips one set of specs from AFK
# substitute to actual third-party round-trip — leave blank to keep
# the AFK path).
#
#   E2E_REAL_GMAIL=1                — flow 4/9/10/11/12 use a real
#                                     dedicated Gmail Workspace
#   E2E_GMAIL_OPERATOR_REFRESH_TOKEN — pre-provisioned refresh token
#                                     for the operator-side mailbox
#   E2E_GMAIL_RECIPIENT_A_*         — for reply detection
#   E2E_GMAIL_RECIPIENT_B_*         — for bounce / unsubscribe
#
#   E2E_REAL_STRIPE=1               — flow 14 uses Stripe Live
#   E2E_STRIPE_PROMO_CODE           — the 100%-off promo code
#
#   E2E_REAL_PDL=1                  — flow 6 uses real PDL credits
#                                     (PDL_API_KEY must also be set
#                                     in the devpod's .env.backend)

CLERK_SECRET_KEY=
E2E_API_URL=http://api-mvp.magiklead.localhost
E2E_FRONTEND_URL=http://mvp.magiklead.localhost

# Real-creds gates — leave commented for AFK runs
# E2E_REAL_GMAIL=1
# E2E_GMAIL_OPERATOR_REFRESH_TOKEN=
# E2E_GMAIL_RECIPIENT_A_EMAIL=
# E2E_GMAIL_RECIPIENT_A_REFRESH_TOKEN=
# E2E_GMAIL_RECIPIENT_B_EMAIL=
# E2E_GMAIL_RECIPIENT_B_REFRESH_TOKEN=
# E2E_REAL_STRIPE=1
# E2E_STRIPE_PROMO_CODE=
# E2E_REAL_PDL=1
