# ---------- Core ----------
PORT=8080
DATABASE_URL=postgres://magiklead:magiklead@localhost:5432/magiklead?sslmode=disable
REDIS_URL=localhost:6379
FRONTEND_URL=http://localhost:3000

# ---------- Clerk ----------
# Secret key from Clerk dashboard → API Keys.
CLERK_SECRET_KEY=sk_test_...
# Publishable key (exposed to the frontend; kept here for reference).
CLERK_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from Clerk dashboard → Webhooks → your endpoint.
# Used to verify Svix signatures on /api/v1/webhooks/clerk.
CLERK_WEBHOOK_SECRET=whsec_...
# ClerkAuth expects a JWT template named "magiklead-backend" that
# includes an `email` claim resolving to {{user.primary_email_address}}.
# Admin gating reads that claim directly without a DB lookup.

# ---------- AI ----------
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Gmail OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI registered on the
# Google OAuth client, and must include the /v1 prefix — the real route
# is /api/v1/gmail/callback. A value without /v1 404s the callback.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/gmail/callback
# Signs the OAuth `state` param (HS256) that carries the tenant + user
# id across the Google consent redirect. The callback is a public route
# (Google arrives with no session), so the binding rides in this signed
# state. Required when GOOGLE_CLIENT_ID is set; any opaque 32+ byte
# string. Keep distinct from UNSUBSCRIBE_SIGNING_SECRET so the two token
# types can't be crossed.
GMAIL_OAUTH_STATE_SECRET=

# ---------- Stripe ----------
# For local dev set sk_test_… / whsec_… (test mode). For the public
# launch flip to sk_live_… / whsec_… from the Stripe dashboard and
# point the Live webhook at https://api.magiklead.com/api/v1/webhooks/stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly Price IDs for the four plans. The webhook handler maps the
# Stripe price back to a plan name; missing entries cause the
# subscription event to log a warning and skip rather than guess. The
# free price is a $0 SKU used only for manual downgrades from the
# Stripe dashboard — the in-app free tier is auto-assigned on tenant
# bootstrap and never hits Stripe.
STRIPE_PRICE_FREE=price_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...
# Annual variants are not wired into the in-app upgrade CTA for v1
# (monthly only). If the operator later enables the annual toggle UI
# they slot in here; the handler's plan resolution can be extended to
# read _ANNUAL when an `interval` field arrives on the request.
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_SCALE_ANNUAL=price_...

# ---------- Admin ----------
# Comma-separated emails that can hit /api/v1/admin/* (matched against
# the Clerk JWT `email` claim, case-insensitive).
ADMIN_EMAILS=ops@magiklead.com

# ---------- System transactional email ----------
# Used for system-originated messages (GDPR erasure confirmation, etc.).
# If unset, the sender logs instead of mailing — fine for dev.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_SMTP_FROM=no-reply@magiklead.com

# ---------- S3 / MinIO (ingest raw payload storage) ----------
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=magiklead-ingest
S3_REGION=us-east-1
S3_USE_SSL=false

# ---------- Ingest sources ----------
SEC_USER_AGENT=MagikLead research@magiklead.com
EDGAR_MAX_RECORDS=
CRUNCHBASE_CSV_DIR=
WIKIDATA_USER_AGENT=MagikLead research@magiklead.com
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_QUERY=
TEAMPAGES_DOMAINS=
TEAMPAGES_DOMAINS_FILE=
